{
  "name": "@mirai-gikai/root",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "db:types:gen": "npx supabase gen types typescript --local > packages/supabase/types/supabase.types.ts",
    "db:migrate": "npx supabase migration up --include-all && pnpm run db:types:gen",
    "db:topics:import": "dotenv -e .env -- node scripts/import-topics-json.mjs",
    "db:topics:import:test": "dotenv -e .env.test -- node scripts/import-topics-json.mjs",
    "db:topics:import:prod": "dotenv -e .env.prod -- node scripts/import-topics-json.mjs",
    "db:council-actions:import": "dotenv -e .env -- node scripts/import-council-actions.mjs",
    "db:council-actions:import:test": "dotenv -e .env.test -- node scripts/import-council-actions.mjs",
    "db:council-actions:import:prod": "dotenv -e .env.prod -- node scripts/import-council-actions.mjs",
    "db:general-questions:import": "dotenv -e .env -- node scripts/import-general-questions.mjs",
    "db:general-questions:import:dry": "dotenv -e .env -- node scripts/import-general-questions.mjs --dry-run",
    "db:general-questions:import:prod": "dotenv -e .env.prod -- node scripts/import-general-questions.mjs",
    "db:reset": "dotenv -e .env -- npx supabase db reset && pnpm db:types:gen && pnpm seed",
    "dev": "dotenv -e .env -- pnpm -r --stream --parallel run dev",
    "seed": "dotenv -e .env -- pnpm --filter @mirai-gikai/seed seed",
    "seed:csv": "dotenv -e .env -- pnpm --filter @mirai-gikai/seed seed:csv",
    "test": "pnpm -r --parallel run test && pnpm test:scripts",
    "test:coverage": "pnpm -r --parallel run test:coverage && pnpm test:scripts",
    "test:scripts": "vitest run scripts/validate-difficulty-coverage.test.mjs scripts/validate-site-wide-difficulty-content-decisions.test.mjs",
    "validate:difficulty-coverage": "node scripts/validate-difficulty-coverage.mjs",
    "test:issue-publisher": "node scripts/issue-publisher/check-negative-samples.mjs",
    "test:integration": "dotenv -e .env -- vitest run --config tests/supabase/vitest.config.mts && pnpm -r run test:integration",
    "test:integration:watch": "dotenv -e .env -- vitest --config tests/supabase/vitest.config.mts",
    "test:integration:coverage": "dotenv -e .env -- vitest run --config tests/supabase/vitest.config.mts && pnpm -r run test:integration:coverage",
    "build": "dotenv -e .env -- pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "biome format . && biome lint .",
    "lint:fix": "biome format --write . && biome lint --write .",
    "postinstall": "npx simple-git-hooks",
    "validate:difficulty-content-decisions": "node scripts/validate-site-wide-difficulty-content-decisions.mjs",
    "test:difficulty-content-decisions": "vitest run scripts/validate-site-wide-difficulty-content-decisions.test.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@supabase/supabase-js": "^2.49.4",
    "dotenv-cli": "^7.4.2",
    "lint-staged": "^15.5.2",
    "simple-git-hooks": "^2.13.1",
    "vitest": "^3.2.4"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "pnpm run lint:fix"
  }
}
