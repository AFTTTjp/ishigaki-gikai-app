# .env.prod — prod 環境（Supabase prod プロジェクト）向け設定
#
# 用途:
#   - import スクリプトを prod Supabase に対して実行するとき
#     例: pnpm db:topics:import:prod / pnpm db:council-actions:import:prod
#   - prod の Next.js アプリに対して revalidate API を呼び出すとき
#   Next.js アプリ自体の起動には使用しない（起動は Vercel 環境変数を使う）。
#
# 作成方法:
#   1. このファイルを .env.prod としてコピーする
#   2. Supabase ダッシュボード（prod プロジェクト）の
#      Settings > API から URL と Service Role Key を取得して記入する
#   3. revalidate を行う場合は PROD_WEB_URL と REVALIDATE_SECRET も記入する
#      （Vercel ダッシュボードの Environment Variables を参照）
#   4. .env.prod は .gitignore で除外されているため、絶対に commit しないこと
#
# ⚠️  警告: prod への反映は取り消しが困難です。
#   必ず dry-run オプションで事前確認してから実行してください。
#   例: npx dotenv-cli -e .env.prod -- node scripts/import-council-actions.mjs --dry-run

# Supabase prod プロジェクトの API URL
# 例: https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# Supabase prod プロジェクトの Service Role Key（秘匿。公開禁止）
SUPABASE_SERVICE_ROLE_KEY=

# prod Next.js アプリの公開 URL（revalidate API 呼び出しで使う）
# 例: https://example.vercel.app  または独自ドメイン
# protocol (https://) を付けることを推奨。付けない場合はスクリプト側で補正する想定。
PROD_WEB_URL=

# prod Next.js アプリで revalidate API の認証に使うシークレット（秘匿。公開禁止）
# Vercel の Environment Variables (Production) に設定されている REVALIDATE_SECRET と同じ値を入れる
REVALIDATE_SECRET=
