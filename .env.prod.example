# .env.prod — prod 環境（Supabase prod プロジェクト）向け設定
#
# 用途:
#   pnpm db:topics:import:prod
#   pnpm db:council-actions:import:prod
#   など、import スクリプトを prod Supabase に対して実行するときだけ使う。
#   Next.js アプリの起動には使用しない。
#
# 作成方法:
#   1. このファイルを .env.prod としてコピーする
#   2. Supabase ダッシュボード（prod プロジェクト）の
#      Settings > API から URL と Service Role Key を取得して記入する
#   3. .env.prod は .gitignore で除外されているため、絶対に commit しないこと
#
# ⚠️  警告: prod への反映は取り消しが困難です。
#   必ず dry-run オプションで事前確認してから実行してください。
#   例: npx dotenv-cli -e .env.prod -- node scripts/import-council-actions.mjs --dry-run

# Supabase prod プロジェクトの API URL
# 例: https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# Supabase prod プロジェクトの Service Role Key（秘匿。公開禁止）
SUPABASE_SERVICE_ROLE_KEY=
