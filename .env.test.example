# .env.test — test 環境（Supabase test プロジェクト）向け設定
#
# 用途:
#   pnpm db:topics:import:test
#   pnpm db:council-actions:import:test
#   など、import スクリプトを test Supabase に対して実行するときだけ使う。
#   Next.js アプリの起動には使用しない。
#
# 作成方法:
#   1. このファイルを .env.test としてコピーする
#   2. Supabase ダッシュボード（test プロジェクト）の
#      Settings > API から URL と Service Role Key を取得して記入する
#   3. .env.test は .gitignore で除外されているため、絶対に commit しないこと

# Supabase test プロジェクトの API URL
# 例: https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# Supabase test プロジェクトの Service Role Key（秘匿。公開禁止）
SUPABASE_SERVICE_ROLE_KEY=
