{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://afttt.jp/schemas/ishigaki-gikai-council-action.schema.json",
  "title": "Ishigaki Gikai Council Action",
  "description": "議会アクション（要請活動・申し入れ・意見書提出など）のデータスキーマ。bills への紐付けは bill_name の完全一致で解決する。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slug",
    "kind",
    "title",
    "action_date",
    "destination_name",
    "description",
    "status",
    "related_bill_names"
  ],
  "properties": {
    "slug": {
      "type": "string",
      "description": "Stable slug used as unique key in DB",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "kind": {
      "type": "string",
      "description": "議会アクションの種別",
      "enum": [
        "advocacy",
        "request",
        "inspection",
        "submission",
        "resolution_delivery"
      ]
    },
    "title": {
      "type": "string",
      "description": "アクションのタイトル（例: 旧市役所跡地の早期着工を求める要請活動）",
      "minLength": 1
    },
    "action_date": {
      "type": "string",
      "description": "活動日（YYYY-MM-DD）",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "destination_name": {
      "type": "string",
      "description": "宛先名（例: 石垣市長、沖縄県知事）",
      "minLength": 1
    },
    "destination_role": {
      "type": ["string", "null"],
      "description": "宛先の役職（例: 市長、知事）"
    },
    "destination_body": {
      "type": ["string", "null"],
      "description": "宛先機関・組織名（例: 石垣市、沖縄県）"
    },
    "description": {
      "type": "string",
      "description": "アクションの概要説明（Markdown可）",
      "minLength": 1
    },
    "official_url": {
      "type": ["string", "null"],
      "description": "公式資料・要請文書のURL",
      "format": "uri"
    },
    "source_url": {
      "type": ["string", "null"],
      "description": "出典URL（報道・議会資料など）",
      "format": "uri"
    },
    "image_url": {
      "type": ["string", "null"],
      "description": "活動写真・資料画像のURL",
      "format": "uri"
    },
    "status": {
      "type": "string",
      "description": "公開状態",
      "enum": ["published", "draft"]
    },
    "related_bill_names": {
      "type": "array",
      "description": "関連議案の名称リスト。bills.name と完全一致で照合する。fuzzy matching 禁止。",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
