{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://afttt.jp/schemas/item-description-final-decisions.schema.json",
  "title": "Item Description Final Decisions",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session",
    "diet_session_slug",
    "artifact_type",
    "artifact_origin",
    "review_status",
    "batch",
    "sources",
    "summary",
    "official_wording_audits",
    "decisions"
  ],
  "properties": {
    "schema_version": {
      "const": "item-description-final-decisions.v1"
    },
    "session": {
      "type": "string",
      "minLength": 1
    },
    "diet_session_slug": {
      "type": "string",
      "minLength": 1
    },
    "artifact_type": {
      "const": "item_description_final_decisions"
    },
    "artifact_origin": {
      "const": "hand_authored_reviewer_decision"
    },
    "review_status": {
      "const": "reviewer_only"
    },
    "batch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "batch_id",
        "reviewed_at",
        "reviewed_from_commit"
      ],
      "properties": {
        "batch_id": {
          "type": "string",
          "minLength": 1
        },
        "reviewed_at": {
          "type": "string",
          "minLength": 1
        },
        "reviewed_from_commit": {
          "type": "string",
          "minLength": 7
        }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_item_total",
        "approve_as_written_total",
        "approve_with_revision_total",
        "hold_total",
        "reject_total",
        "approved_normal_total",
        "approved_detailed_total",
        "public_json_changed",
        "production_import_executed",
        "revalidation_executed"
      ],
      "properties": {
        "target_item_total": {
          "type": "integer",
          "const": 22
        },
        "approve_as_written_total": {
          "type": "integer",
          "minimum": 0
        },
        "approve_with_revision_total": {
          "type": "integer",
          "minimum": 0
        },
        "hold_total": {
          "type": "integer",
          "minimum": 0
        },
        "reject_total": {
          "type": "integer",
          "minimum": 0
        },
        "approved_normal_total": {
          "type": "integer",
          "minimum": 0
        },
        "approved_detailed_total": {
          "type": "integer",
          "minimum": 0
        },
        "public_json_changed": {
          "const": false
        },
        "production_import_executed": {
          "const": false
        },
        "revalidation_executed": {
          "const": false
        }
      }
    },
    "official_wording_audits": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "decisions": {
      "type": "array",
      "minItems": 22,
      "maxItems": 22,
      "items": {
        "$ref": "#/$defs/decision"
      }
    }
  },
  "$defs": {
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_id",
        "questioner",
        "question_id",
        "item_id",
        "item_number",
        "item_title",
        "candidate_recommendation",
        "decision",
        "approved_normal_description",
        "approved_detailed_description",
        "source_utterance_ids",
        "source_support",
        "revision_notes",
        "official_wording_check",
        "ocr_risk",
        "answer_content_check",
        "unsupported_inference_check",
        "recovery_requirements"
      ],
      "properties": {
        "decision_id": {
          "type": "string",
          "minLength": 1
        },
        "questioner": {
          "type": "string",
          "minLength": 1
        },
        "question_id": {
          "type": "string",
          "minLength": 1
        },
        "item_id": {
          "type": "string",
          "pattern": "^item[0-9]{2}$"
        },
        "item_number": {
          "type": "integer",
          "minimum": 1
        },
        "item_title": {
          "type": "string",
          "minLength": 1
        },
        "candidate_recommendation": {
          "type": "string",
          "enum": [
            "review_ready",
            "review_ready_with_note",
            "hold_item_match_ambiguous"
          ]
        },
        "decision": {
          "type": "string",
          "enum": [
            "approve_as_written",
            "approve_with_revision",
            "hold_item_match_ambiguous",
            "hold_source_support",
            "hold_official_wording_unconfirmed"
          ]
        },
        "approved_normal_description": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 120
        },
        "approved_detailed_description": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 400
        },
        "source_utterance_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_support": {
          "type": "object"
        },
        "revision_notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "official_wording_check": {
          "type": "object"
        },
        "ocr_risk": {
          "type": "object"
        },
        "answer_content_check": {
          "type": "object"
        },
        "unsupported_inference_check": {
          "type": "object"
        },
        "recovery_requirements": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "decision": {
                "enum": [
                  "approve_as_written",
                  "approve_with_revision"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "approved_normal_description": {
                "type": "string"
              },
              "approved_detailed_description": {
                "type": "string"
              },
              "recovery_requirements": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "decision": {
                "enum": [
                  "hold_item_match_ambiguous",
                  "hold_source_support",
                  "hold_official_wording_unconfirmed"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "approved_normal_description": {
                "type": "null"
              },
              "approved_detailed_description": {
                "type": "null"
              },
              "recovery_requirements": {
                "type": "object"
              }
            }
          }
        }
      ]
    }
  }
}
