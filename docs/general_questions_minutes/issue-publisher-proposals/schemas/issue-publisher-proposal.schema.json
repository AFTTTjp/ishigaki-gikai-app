{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "issue-publisher-proposal.schema.json",
  "title": "Issue Publisher Proposal",
  "type": "object",
  "required": [
    "schema_version",
    "proposal_id",
    "proposal_kind",
    "publication_status",
    "issue_id",
    "issue_title",
    "diet_session_slug",
    "claim_type",
    "proposal_type",
    "public_draft",
    "evidence",
    "links",
    "review"
  ],
  "properties": {
    "schema_version": {
      "const": "issue-publisher-proposal.v0"
    },
    "proposal_id": {
      "type": "string",
      "minLength": 1
    },
    "proposal_kind": {
      "type": "string",
      "minLength": 1
    },
    "publication_status": {
      "type": "string",
      "enum": ["not_published", "approved_for_export", "rejected"]
    },
    "note": {
      "type": "string"
    },
    "issue_id": {
      "type": "string",
      "minLength": 1
    },
    "issue_title": {
      "type": "string",
      "minLength": 1
    },
    "diet_session_slug": {
      "type": "string",
      "minLength": 1
    },
    "claim_type": {
      "type": "string",
      "enum": ["attributed_speech", "fact"]
    },
    "proposal_type": {
      "type": "string",
      "enum": [
        "discussion_point",
        "timeline_event",
        "topic_update",
        "related_bill",
        "related_question",
        "bill_enrichment"
      ]
    },
    "public_draft": {
      "type": "object",
      "required": ["summary_easy", "summary_detailed"],
      "properties": {
        "summary_easy": {
          "type": "string",
          "minLength": 1
        },
        "summary_detailed": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_type", "anchor", "evidence_role", "mode"],
        "properties": {
          "source_type": {
            "type": "string",
            "enum": [
              "general_question_minutes",
              "official_minutes",
              "bill_text",
              "council_action",
              "review_draft",
              "issue_review_packet",
              "issue_editorial_decisions",
              "session_editorial_map",
              "editorial_note",
              "issue_graph"
            ]
          },
          "anchor": {
            "type": "string",
            "minLength": 1
          },
          "evidence_role": {
            "type": "string",
            "enum": ["primary", "secondary"]
          },
          "mode": {
            "type": "string",
            "enum": ["quote", "paraphrase"]
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "links": {
      "type": "object",
      "required": ["related_bill_ids", "related_question_slugs"],
      "properties": {
        "related_bill_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "related_question_slugs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "candidate_v2": {
      "type": "object",
      "required": [
        "source_scope",
        "question",
        "city_answer",
        "confirmed_facts",
        "unresolved_or_not_confirmed",
        "recommended_reflection"
      ],
      "properties": {
        "source_scope": {
          "type": "object",
          "required": [
            "question_slug",
            "question_date",
            "item_number",
            "item_title"
          ],
          "properties": {
            "question_slug": {
              "type": "string",
              "minLength": 1
            },
            "question_date": {
              "type": "string",
              "format": "date"
            },
            "item_number": {
              "type": "integer",
              "minimum": 1
            },
            "item_title": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "question": {
          "type": "object",
          "required": ["summary", "anchor_ids", "expected_speaker_role"],
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 1
            },
            "anchor_ids": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "expected_speaker_role": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "city_answer": {
          "type": "object",
          "required": ["summary", "anchor_ids", "expected_speaker_role"],
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 1
            },
            "anchor_ids": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "expected_speaker_role": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "confirmed_facts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["statement", "anchor_ids", "status", "public_use"],
            "properties": {
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "anchor_ids": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "status": {
                "type": "string",
                "minLength": 1
              },
              "public_use": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "unresolved_or_not_confirmed": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["statement", "reason", "anchor_ids"],
            "properties": {
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "anchor_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "recommended_reflection": {
          "type": "object",
          "required": [
            "surface",
            "target",
            "kind",
            "status_label",
            "safe_scope",
            "avoid"
          ],
          "properties": {
            "surface": {
              "type": "string",
              "minLength": 1
            },
            "target": {
              "type": "object",
              "required": ["type", "slug"],
              "properties": {
                "type": {
                  "type": "string",
                  "minLength": 1
                },
                "slug": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "kind": {
              "type": "string",
              "minLength": 1
            },
            "status_label": {
              "type": "string",
              "minLength": 1
            },
            "safe_scope": {
              "type": "string",
              "minLength": 1
            },
            "avoid": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "export": {
      "type": "object",
      "required": ["target"],
      "properties": {
        "target": {
          "type": "string",
          "enum": [
            "topic_json",
            "bill_json",
            "general_question_json",
            "none"
          ]
        },
        "target_slug": {
          "type": "string",
          "minLength": 1
        },
        "source_proposal_id": {
          "type": "string",
          "minLength": 1
        },
        "exported_at": {
          "type": "string",
          "format": "date-time"
        },
        "exported_by": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "review": {
      "type": "object",
      "required": ["status", "needs_human_review", "review_reason"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "edited", "rejected"]
        },
        "needs_human_review": {
          "type": "boolean"
        },
        "review_reason": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        },
        "approval_note": {
          "type": "string",
          "minLength": 1
        },
        "export_readiness": {
          "type": "string",
          "enum": [
            "not_ready",
            "ready_for_export",
            "blocked"
          ]
        },
        "export_blockers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
