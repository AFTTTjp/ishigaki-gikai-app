{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "issue-publisher-proposal.schema.json",
  "title": "Issue Publisher Proposal",
  "type": "object",
  "required": [
    "schema_version",
    "proposal_id",
    "proposal_kind",
    "publication_status",
    "issue_id",
    "issue_title",
    "diet_session_slug",
    "claim_type",
    "proposal_type",
    "public_draft",
    "evidence",
    "links",
    "review"
  ],
  "properties": {
    "schema_version": {
      "const": "issue-publisher-proposal.v0"
    },
    "proposal_id": {
      "type": "string",
      "minLength": 1
    },
    "proposal_kind": {
      "type": "string",
      "minLength": 1
    },
    "publication_status": {
      "type": "string",
      "enum": ["not_published", "approved_for_export", "rejected"]
    },
    "note": {
      "type": "string"
    },
    "issue_id": {
      "type": "string",
      "minLength": 1
    },
    "issue_title": {
      "type": "string",
      "minLength": 1
    },
    "diet_session_slug": {
      "type": "string",
      "minLength": 1
    },
    "claim_type": {
      "type": "string",
      "enum": ["attributed_speech", "fact"]
    },
    "proposal_type": {
      "type": "string",
      "enum": [
        "discussion_point",
        "timeline_event",
        "topic_update",
        "related_bill",
        "related_question",
        "bill_enrichment"
      ]
    },
    "public_draft": {
      "type": "object",
      "required": ["summary_easy", "summary_detailed"],
      "properties": {
        "summary_easy": {
          "type": "string",
          "minLength": 1
        },
        "summary_detailed": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_type", "anchor", "evidence_role", "mode"],
        "properties": {
          "source_type": {
            "type": "string",
            "enum": [
              "general_question_minutes",
              "official_minutes",
              "bill_text",
              "council_action",
              "review_draft",
              "issue_review_packet",
              "issue_editorial_decisions",
              "session_editorial_map",
              "editorial_note",
              "issue_graph"
            ]
          },
          "anchor": {
            "type": "string",
            "minLength": 1
          },
          "evidence_role": {
            "type": "string",
            "enum": ["primary", "secondary"]
          },
          "mode": {
            "type": "string",
            "enum": ["quote", "paraphrase"]
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "links": {
      "type": "object",
      "required": ["related_bill_ids", "related_question_slugs"],
      "properties": {
        "related_bill_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "related_question_slugs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "review": {
      "type": "object",
      "required": ["status", "needs_human_review", "review_reason"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "edited", "rejected"]
        },
        "needs_human_review": {
          "type": "boolean"
        },
        "review_reason": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
