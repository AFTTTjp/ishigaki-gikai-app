{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://afttt.jp/schemas/ishigaki-gikai-candidate-inventory.schema.json",
  "title": "Issue Publisher Candidate Inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session",
    "diet_session_slug",
    "generated_at",
    "generated_from",
    "summary",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": "candidate-inventory.v1"
    },
    "session": {
      "type": "string",
      "minLength": 1
    },
    "diet_session_slug": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "generated_from": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "general_question_count",
        "entry_count",
        "speaker_role_counts",
        "recommended_reflection_counts",
        "risk_flag_counts"
      ],
      "properties": {
        "general_question_count": {
          "type": "integer",
          "minimum": 0
        },
        "entry_count": {
          "type": "integer",
          "minimum": 0
        },
        "speaker_role_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "recommended_reflection_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "risk_flag_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "speaker_name",
          "speaker_role",
          "general_question_slug_or_id",
          "theme",
          "question_summary",
          "city_answer_summary",
          "city_answer_anchor",
          "city_answer_excerpt",
          "city_answer_missing",
          "answer_anchor_confidence",
          "answer_anchor_source",
          "recoverable_answer_candidates",
          "confirmed_fact_candidates",
          "confirmed_facts",
          "unconfirmed_or_not_decided",
          "recommended_reflection",
          "risk_flags",
          "anchor",
          "confidence"
        ],
        "properties": {
          "candidate_id": {
            "type": "string",
            "minLength": 1
          },
          "speaker_name": {
            "type": "string",
            "minLength": 1
          },
          "speaker_role": {
            "type": "string",
            "enum": [
              "council_member",
              "city",
              "executive",
              "unknown"
            ]
          },
          "general_question_slug_or_id": {
            "type": "string",
            "minLength": 1
          },
          "theme": {
            "type": "string",
            "minLength": 1
          },
          "question_summary": {
            "type": "string"
          },
          "city_answer_summary": {
            "type": "string"
          },
          "city_answer_anchor": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "utterance_id",
              "source_file",
              "speaker",
              "speaker_role",
              "line_or_time_hint"
            ],
            "properties": {
              "utterance_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "source_file": {
                "type": "string",
                "minLength": 1
              },
              "speaker": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "speaker_role": {
                "type": "string",
                "enum": [
                  "city",
                  "executive",
                  "unknown"
                ]
              },
              "line_or_time_hint": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "city_answer_excerpt": {
            "type": "string"
          },
          "city_answer_missing": {
            "type": "boolean"
          },
          "answer_anchor_confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "answer_anchor_source": {
            "type": "string",
            "enum": [
              "direct_item_match",
              "unknown_answer_like",
              "null_item_proximity",
              "none"
            ]
          },
          "recoverable_answer_candidates": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "utterance_id",
                "source_file",
                "speaker",
                "speaker_role",
                "excerpt",
                "reason",
                "confidence"
              ],
              "properties": {
                "utterance_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "source_file": {
                  "type": "string",
                  "minLength": 1
                },
                "speaker": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "speaker_role": {
                  "type": "string",
                  "enum": [
                    "city",
                    "executive",
                    "unknown"
                  ]
                },
                "excerpt": {
                  "type": "string"
                },
                "reason": {
                  "type": "string",
                  "enum": [
                    "null_item_proximity",
                    "segmentation_mixed",
                    "later_followup_answer",
                    "unknown_answer_like"
                  ]
                },
                "confidence": {
                  "type": "string",
                  "enum": [
                    "low"
                  ]
                }
              }
            }
          },
          "confirmed_fact_candidates": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "fact",
                "utterance_id",
                "source_file",
                "speaker",
                "speaker_role",
                "excerpt",
                "reason",
                "confidence"
              ],
              "properties": {
                "fact": {
                  "type": "string",
                  "minLength": 1
                },
                "utterance_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "source_file": {
                  "type": "string",
                  "minLength": 1
                },
                "speaker": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "speaker_role": {
                  "type": "string",
                  "enum": [
                    "city",
                    "executive",
                    "unknown"
                  ]
                },
                "excerpt": {
                  "type": "string"
                },
                "reason": {
                  "type": "string",
                  "enum": [
                    "direct_item_match_sentence"
                  ]
                },
                "confidence": {
                  "type": "string",
                  "enum": [
                    "medium"
                  ]
                }
              }
            }
          },
          "confirmed_facts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "unconfirmed_or_not_decided": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "recommended_reflection": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "target_topic_slug",
              "suggested_new_topic_slug",
              "reason"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "existing_topic_update",
                  "new_topic",
                  "general_question_only",
                  "no_reflection",
                  "needs_review"
                ]
              },
              "target_topic_slug": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "suggested_new_topic_slug": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "risk_flags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "anchor": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_file",
              "quote_or_excerpt",
              "speaker",
              "line_or_time_hint"
            ],
            "properties": {
              "source_file": {
                "type": "string",
                "minLength": 1
              },
              "quote_or_excerpt": {
                "type": "string"
              },
              "speaker": {
                "type": "string"
              },
              "line_or_time_hint": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          }
        }
      }
    }
  }
}
